<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer.
  Android adaptive icon canvas: 108dp × 108dp
  Safe zone (guaranteed visible): central 72dp × 72dp (66.7% of canvas)

  The <inset> of 20% on each side = 21.6dp, pushing artwork into a
  64.8dp × 64.8dp region — well within the 72dp safe zone.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_bitmap"
    android:insetLeft="20%"
    android:insetRight="20%"
    android:insetTop="20%"
    android:insetBottom="20%" />